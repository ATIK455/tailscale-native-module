+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build linux && !ts_omit_gro
+
+package tstun
+
+import (
+	"testing"
+
+	"github.com/tailscale/wireguard-go/tun"
+	"golang.org/x/sys/unix"
+	"tailscale.com/control/controlknobs"
+)
+
+type groTestDevice struct {
+	tun.Device
+	udpDisabled, tcpDisabled bool
+	probeErr                 error
+}
+
+func (d *groTestDevice) DisableUDPGRO() { d.udpDisabled = true }
+func (d *groTestDevice) DisableTCPGRO() { d.tcpDisabled = true }
+func (d *groTestDevice) Write(bufs [][]byte, offset int) (int, error) {
+	return len(bufs), d.probeErr
+}
+
+// This test also builds for Android, where the AOSP daemon uses a Linux TUN.
+func TestTUNGROControls(t *testing.T) {
+	t.Setenv("TS_TUN_DISABLE_UDP_GRO", "false")
+	t.Setenv("TS_TUN_DISABLE_TCP_GRO", "false")
+	t.Run("startup-knob-and-live-update", func(t *testing.T) {
+		dev := new(groTestDevice)
+		w := &Wrapper{tdev: dev, logf: t.Logf}
+		knobs := new(controlknobs.Knobs)
+		knobs.DisableTUNUDPGRO.Store(true)
+		w.SetLinkFeaturesPostUp(knobs)
+		if !dev.udpDisabled || dev.tcpDisabled {
+			t.Fatalf("startup: UDP disabled=%v, TCP disabled=%v", dev.udpDisabled, dev.tcpDisabled)
+		}
+		knobs.DisableTUNTCPGRO.Store(true)
+		w.ApplyGROKnobs(knobs)
+		if !dev.tcpDisabled {
+			t.Fatal("live control change did not disable TCP GRO")
+		}
+	})
+	t.Run("unsupported-kernel", func(t *testing.T) {
+		dev := &groTestDevice{probeErr: unix.EINVAL}
+		w := &Wrapper{tdev: dev, logf: t.Logf}
+		w.SetLinkFeaturesPostUp(nil)
+		if !dev.udpDisabled || !dev.tcpDisabled {
+			t.Fatal("failed GRO probe must disable both TCP and UDP GRO")
+		}
+	})
+	t.Run("tap", func(t *testing.T) {
+		dev := new(groTestDevice)
+		w := &Wrapper{tdev: dev, logf: t.Logf, isTAP: true}
+		knobs := new(controlknobs.Knobs)
+		knobs.DisableTUNUDPGRO.Store(true)
+		knobs.DisableTUNTCPGRO.Store(true)
+		w.SetLinkFeaturesPostUp(knobs)
+		w.ApplyGROKnobs(knobs)
+		if dev.udpDisabled || dev.tcpDisabled {
+			t.Fatal("TUN GRO controls must not be applied to TAP devices")
+		}
+	})
+}
